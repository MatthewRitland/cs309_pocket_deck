<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MainActivity"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/gold">

    <TextView
        android:id="@+id/main_msg_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="100dp"
        android:textSize="70dp"
        android:textStyle="bold"
        android:textColor="#C92C06">
    </TextView>

    <Button
        android:id="@+id/myButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="150dp"
        android:backgroundTint="@color/cardinal"
        android:text="Cy Button"
        android:textSize="20dp">
    </Button>

    <ImageButton
        android:layout_gravity="center"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:src="@drawable/cy">
    </ImageButton>

</androidx.appcompat.widget.LinearLayoutCompat>