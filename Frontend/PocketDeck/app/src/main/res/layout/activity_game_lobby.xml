<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/casinotable" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lobby_gameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:shadowColor="@color/cardview_shadow_start_color"
                android:shadowDx="0"
                android:shadowDy="6"
                android:shadowRadius="12"
                android:text="GMode"
                android:textAlignment="center"
                android:textColor="@color/cardinal"
                android:textSize="60sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/lobby_publicToggle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="0"
                android:backgroundTint="@color/cardinal"
                android:text="Private" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="60px"
            android:paddingRight="120px">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lobby_joinedUsersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/lobby_inviteButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/cardinal"
                android:paddingLeft="80dp"
                android:paddingTop="15dp"
                android:paddingRight="80dp"
                android:paddingBottom="15dp"
                android:text="Invite"
                android:textAlignment="center"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:orientation="horizontal">

            <Button
                android:id="@+id/lobby_readyButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/cardinal"
                android:paddingLeft="50dp"
                android:paddingTop="10dp"
                android:paddingRight="50dp"
                android:paddingBottom="10dp"
                android:shadowColor="@color/cardview_shadow_start_color"
                android:shadowDx="12"
                android:shadowDy="12"
                android:shadowRadius="8"
                android:text="Ready"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/lobby_leaveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/transparent"
                android:paddingLeft="50dp"
                android:paddingTop="10dp"
                android:paddingRight="50dp"
                android:paddingBottom="10dp"
                android:shadowColor="@color/cardview_shadow_start_color"
                android:shadowDx="12"
                android:shadowDy="12"
                android:shadowRadius="8"
                android:text="Leave"
                android:textColor="@color/cardinal"
                android:textSize="16sp"
                app:strokeColor="@color/cardinal"
                app:strokeWidth="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>