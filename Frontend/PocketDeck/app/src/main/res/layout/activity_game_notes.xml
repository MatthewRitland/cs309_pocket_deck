<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/casinotable"
    android:padding="20dp">

    <TextView
        android:id="@+id/notesTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Edit Game Note"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#66000000"
        android:padding="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/noteEdit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:hint="Write your note for this game..."
        android:textColor="@android:color/black"
        android:textColorHint="#777777"
        android:background="@android:color/white"
        android:gravity="top"
        android:padding="16dp"
        android:textSize="18sp"
        android:inputType="textMultiLine"
        app:layout_constraintTop_toBottomOf="@id/notesTitle"
        app:layout_constraintBottom_toTopOf="@id/buttonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/saveNoteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Note"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/cardinal" />

        <Button
            android:id="@+id/clearNoteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clear Text"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/cardinal" />

        <Button
            android:id="@+id/deleteNoteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Note"
            android:textColor="@android:color/white"
            android:backgroundTint="#B22222" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>